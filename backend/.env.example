# Copiar este archivo a .env y completar los valores.
# .env NO se versiona (está en .gitignore).

# --- PostgreSQL ---
# localhost: para correr el backend local (npm run dev) contra el Postgres de Docker.
# En modo Docker completo no hace falta cambiarlo: docker-compose lo pisa con DB_HOST=postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_yacanto
DB_USER=hotel_app
DB_PASSWORD=hotel_app_dev_2026

# --- Servidor ---
PORT=3000

# Orígenes permitidos por CORS, separados por comas. Sin barra final.
# Local: el puerto del dev server de Vite. Producción: el dominio del frontend.
# Si queda vacío, el default es http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Secreto para firmar JWT. Generar uno propio con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# --- Supabase Storage (CVs adjuntos) ---
# Crear proyecto gratuito en supabase.com, luego un bucket PRIVADO llamado "cvs".
# SUPABASE_URL: Settings → API → Project URL
# SUPABASE_SERVICE_KEY: Settings → API → service_role key (NUNCA exponerla al frontend)
# Si quedan vacíos, la función de CV responde 503 y el resto del sistema funciona igual.

# Cifrado de datos personales (AES-256-GCM, 32 bytes hex)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

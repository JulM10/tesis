{
  "info": {
    "name": "RRHH API - Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de APIs del sistema RRHH (Auth, Empleados, Calendario y Horarios).\n\nUso: ejecutar primero 'POST - Login' (carpeta Auth). El token se guarda solo en la variable TOKEN y el resto de los requests lo usan automáticamente.\n\nUsuarios demo (ver backend/database/seed.sql): admin@hotel.com / Admin123!, rrhh@hotel.com / Rrhh123!, empleado@hotel.com / Empleado123!"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{TOKEN}}", "type": "string" }]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3000/api" },
    { "key": "TOKEN", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('TOKEN', pm.response.json().token);",
                  "  console.log('TOKEN guardado en la colección');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hotel.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Empleados",
      "item": [
        {
          "name": "GET - Listar empleados",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/empleados",
              "host": ["{{BASE_URL}}"],
              "path": ["empleados"]
            }
          }
        },
        {
          "name": "GET - Empleado por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/empleados/1",
              "host": ["{{BASE_URL}}"],
              "path": ["empleados", "1"]
            }
          }
        },
        {
          "name": "POST - Crear empleado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"edad\": 30,\n  \"id_puesto\": 1,\n  \"id_lugar\": 1\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/empleados",
              "host": ["{{BASE_URL}}"],
              "path": ["empleados"]
            }
          }
        },
        {
          "name": "PUT - Actualizar empleado",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Gómez\",\n  \"edad\": 31,\n  \"id_puesto\": 2,\n  \"id_lugar\": 1\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/empleados/1",
              "host": ["{{BASE_URL}}"],
              "path": ["empleados", "1"]
            }
          }
        },
        {
          "name": "DELETE - Eliminar empleado",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{BASE_URL}}/empleados/1",
              "host": ["{{BASE_URL}}"],
              "path": ["empleados", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Calendario",
      "item": [
        {
          "name": "GET - Listar calendarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/calendario",
              "host": ["{{BASE_URL}}"],
              "path": ["calendario"]
            }
          }
        },
        {
          "name": "GET - Calendario por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/calendario/1",
              "host": ["{{BASE_URL}}"],
              "path": ["calendario", "1"]
            }
          }
        },
        {
          "name": "POST - Crear calendario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2025-11-20\",\n  \"hora_inicio\": \"08:00\",\n  \"hora_fin\": \"16:00\",\n  \"id_puesto\": 1\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/calendario",
              "host": ["{{BASE_URL}}"],
              "path": ["calendario"]
            }
          }
        },
        {
          "name": "GET - Horarios por fecha",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/calendario/fecha/2025-11-20",
              "host": ["{{BASE_URL}}"],
              "path": ["calendario", "fecha", "2025-11-20"]
            }
          }
        },
        {
          "name": "GET - Horarios por fecha y puesto",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/calendario/fecha/2025-11-20/puesto/1",
              "host": ["{{BASE_URL}}"],
              "path": ["calendario", "fecha", "2025-11-20", "puesto", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Horarios",
      "item": [
        {
          "name": "GET - Todos los horarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/horarios",
              "host": ["{{BASE_URL}}"],
              "path": ["horarios"]
            }
          }
        },
        {
          "name": "GET - Horarios por empleado",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/horarios/empleado/1",
              "host": ["{{BASE_URL}}"],
              "path": ["horarios", "empleado", "1"]
            }
          }
        },
        {
          "name": "GET - Horarios por día",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/horarios/dia/2025-11-20",
              "host": ["{{BASE_URL}}"],
              "path": ["horarios", "dia", "2025-11-20"]
            }
          }
        },
        {
          "name": "POST - Asignar empleado a turno",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_empleado\": 2,\n  \"id_calendario\": 3\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/horarios/asignar",
              "host": ["{{BASE_URL}}"],
              "path": ["horarios", "asignar"]
            }
          }
        },
        {
          "name": "GET - Empleados por turno",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/horarios/turno/1",
              "host": ["{{BASE_URL}}"],
              "path": ["horarios", "turno", "1"]
            }
          }
        },
        {
          "name": "DELETE - Quitar empleado de turno",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{BASE_URL}}/horarios/asignar/1/1",
              "host": ["{{BASE_URL}}"],
              "path": ["horarios", "asignar", "1", "1"]
            }
          }
        }
      ]
    }
  ]
}
